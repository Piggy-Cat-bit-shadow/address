PUBLIC_API_BASE_URL=/web-api
API_HOST=127.0.0.1
API_PORT=8787
ADDRESS_DATABASE_PATH=data/address.sqlite
CONTROL_DATABASE_PATH=data/control.sqlite
# Generate with: openssl rand -base64 32
CONFIG_MASTER_KEY=GENERATE_32_BYTE_BASE64_VALUE
# Used only when control.sqlite has no administrator identity.
ADMIN_BOOTSTRAP_PASSWORD=REPLACE_WITH_STRONG_INITIAL_PASSWORD
COOKIE_SECURE=false
STATIC_ROOT=dist
TRUST_PROXY=false
ALLOWED_ORIGIN=
IP_GEOLOCATION_API_URL=https://ipwho.is/{ip}
IP_GEOLOCATION_FALLBACK_API_URL=https://ipapi.co/{ip}/json/

# Which generate modes may call live external providers (comma list of: address,residential,ip-region).
# Modes not listed always use the local database only. Default: ip-region
LIVE_API_MODES=ip-region
# Server-side AMap WebService key used by address synchronization and lookup.
AMAP_API_KEY=
AMAP_API_KEY_2=
BAIDU_API_KEY=
TENCENT_API_KEY=
GEOAPIFY_API_KEY=
ONEMAP_ACCESS_TOKEN=

# Browser map display. These values only initialize an empty control database;
# later administrator changes stored in control.sqlite take precedence.
AMAP_JS_API_KEY=
AMAP_JS_SECURITY_CODE=
MAP_GOOGLE_CHINA_ENABLED=true
MAP_GOOGLE_INTERNATIONAL_ENABLED=true
MAP_AMAP_CHINA_ENABLED=false
MAP_AMAP_INTERNATIONAL_ENABLED=false

# Online translation is optional. Offline pool generation works with this disabled.
GOOGLE_TRANSLATION_ENABLED=false
YOUDAO_APP_KEY=
YOUDAO_APP_SECRET=

# Optional override for the custom blacklist keyword file (default: data/blacklist.txt, hot-reloaded ~10s)
# ADDRESS_BLACKLIST_FILE=data/blacklist.txt
SYNC_CONTROL_URL=http://127.0.0.1:8791
SYNC_CONTROL_PUBLIC=false
HOT_POOL_COUNTRIES=
HOT_POOL_MIN_PER_SLOT=1
