# Add these locations to the static HTTP server configuration.
# The GitHub Actions deployment maintains <deploy-root>/current atomically.
root /path/to/static-site/current;
index index.html;

location = /data/countries.json {
    try_files $uri =404;
    add_header Cache-Control "no-cache" always;
}

location /data/ {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=300, must-revalidate" always;
}

location /_astro/ {
    try_files $uri =404;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
}

location / {
    try_files $uri $uri/ =404;
}
