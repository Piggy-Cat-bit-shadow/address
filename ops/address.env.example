# VPS runtime configuration. Copy to /root/address/runtime/address.env and chmod 600.
PUBLIC_API_BASE_URL=/web-api
API_HOST=127.0.0.1
API_PORT=8787
ALLOWED_ORIGIN=https://YOUR_DOMAIN.example
TRUST_PROXY=true
STATIC_ROOT=/root/address/app/dist
POSTGRES_URL=postgresql://address:REPLACE_WITH_PASSWORD@127.0.0.1:5432/address
POSTGRES_POOL_MAX=64
POSTGRES_POOL_MIN=4
CONFIG_MASTER_KEY=GENERATE_32_BYTE_BASE64_VALUE
ADMIN_BOOTSTRAP_PASSWORD=REPLACE_WITH_STRONG_INITIAL_PASSWORD
COOKIE_SECURE=true
ADDRESS_DATA_ROOT=/root/address/data
ADDRESS_SYNC_CACHE_DIR=/root/address/data/staging
ADDRESS_BLACKLIST_FILE=/root/address/data/blacklist.txt
ADDRESS_SYNC_PROCESS_TIMEOUT_MS=1800000
SYNC_JOB_TIMEOUT_MS=5400000
SYNC_QUEUE_MAX_FAILURES=3
SYNC_QUEUE_MAX_TIMEOUT_FAILURES=2
ADDRESS_SYNC_CLEANUP_INTERVAL_MS=900000
ADDRESS_SYNC_ARTIFACT_STALE_MS=21600000

IP_GEOLOCATION_API_URL=https://ipwho.is/{ip}
IP_GEOLOCATION_FALLBACK_API_URL=https://ipapi.co/{ip}/json/
# Server-side AMap WebService key used by China community synchronization (numbered suffixes add extra keys).
AMAP_API_KEY=
AMAP_API_KEY_2=
BAIDU_API_KEY=
TENCENT_API_KEY=
# Required for the KR initial import (reverse-postcode geocoding); free tier is sufficient.
GEOAPIFY_API_KEY=
# Optional; broadens SG HDB building matching. Tokens expire after 3 days.
ONEMAP_ACCESS_TOKEN=
# Optional live-lookup providers (leave empty to disable).
GOOGLE_GEOCODING_API_KEY=
OS_DATA_HUB_API_KEY=

# Browser map display. These values only initialize an empty control database;
# later administrator changes stored in PostgreSQL take precedence.
AMAP_JS_API_KEY=
AMAP_JS_SECURITY_CODE=
MAP_GOOGLE_CHINA_ENABLED=true
MAP_GOOGLE_INTERNATIONAL_ENABLED=true
MAP_AMAP_CHINA_ENABLED=false
MAP_AMAP_INTERNATIONAL_ENABLED=false

GOOGLE_TRANSLATION_ENABLED=false
YOUDAO_APP_KEY=
YOUDAO_APP_SECRET=
TRANSLATION_BACKFILL_ENABLED=false

ADDRESS_STORAGE_SOFT_LIMIT_BYTES=42949672960
ADDRESS_STORAGE_HARD_LIMIT_BYTES=48318382080
ADDRESS_SYNC_MAX_RECORDS_PER_SHARD=50000
ADDRESS_SYNC_RECORDS_PER_LOCALITY=64
ADDRESS_SYNC_OVERTURE_BUILDINGS=true
ADDRESS_SYNC_REQUIRE_RESIDENTIAL=true
ADDRESS_SYNC_TRANSLATION_ENABLED=false
ADDRESS_SYNC_TRANSLATION_COUNTRIES=HK
ADDRESS_SYNC_RETAIN_RAW=false
ADDRESS_SYNC_RETRY_ATTEMPTS=3
ADDRESS_SYNC_RETRY_BASE_MS=1000
ADDRESS_SYNC_POSTGRES_STATEMENT_TIMEOUT_MS=900000
ADDRESS_SYNC_MAX_PREPARE_CONCURRENCY=1
ADDRESS_SYNC_MAX_CPU_CONCURRENCY=1
ADDRESS_SYNC_MIN_FREE_MEMORY_BYTES=2147483648

SYNC_ADMIN_TOKEN=GENERATE_A_RANDOM_VALUE
SYNC_ADMIN_ORIGIN=
SYNC_CONTROL_URL=http://127.0.0.1:8791
SYNC_CONTROL_PUBLIC=false
SYNC_HOST=127.0.0.1
SYNC_PORT=8791
SYNC_STATE_DIR=/root/address/runtime/sync-control
# true: the sync service auto-runs the resumable initial import on start and daily updates at SYNC_UTC_HOUR.
SYNC_SCHEDULER_ENABLED=true
SYNC_UTC_HOUR=3
SYNC_INITIAL_RETRY_MS=300000
SYNC_DAILY_MAX_ATTEMPTS=3
SYNC_DAILY_RETRY_MS=60000
SYNC_QUEUE_MAX_FAILURES=8
SYNC_QUEUE_SUSPEND_MS=86400000
SYNC_JOB_TIMEOUT_MS=10800000
ADDRESS_SYNC_PROCESS_TIMEOUT_MS=5400000
