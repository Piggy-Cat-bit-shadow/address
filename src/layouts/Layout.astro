---
import '../styles/global.css';
import type { Locale } from '../domain/types';

interface Props { locale: Locale }
const { locale } = Astro.props;
const title = locale === 'en' ? 'Address Lite · Verified Residential Addresses' : 'Address Lite · 真实住宅地址';
const description = locale === 'en'
  ? 'A static, source-backed collection of residential addresses verified during the build.'
  : '构建阶段完成真实来源与住宅证据验证的全静态地址库。';
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f4f6fa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c111b" media="(prefers-color-scheme: dark)" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Address Lite" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="alternate" hreflang="en" href="/en/" />
    <link rel="alternate" hreflang="zh-Hans" href="/zh-CN/" />
    <title>{title}</title>
  </head>
  <body><slot /></body>
</html>
