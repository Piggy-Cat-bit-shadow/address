---
import '../styles/global.css';
import type { Locale } from '../domain/types';

interface Props { locale: Locale }
const { locale } = Astro.props;
const title = locale === 'en' ? 'Address Lite · Verified Residential Addresses' : 'Address Lite · 真实住宅地址';
const description = locale === 'en'
  ? 'A static, source-backed collection of residential addresses verified during the build.'
  : '构建阶段完成真实来源与住宅证据验证的全静态地址库。';
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f9ff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" hreflang="en" href="/en/" />
    <link rel="alternate" hreflang="zh-Hans" href="/zh-CN/" />
    <title>{title}</title>
  </head>
  <body><slot /></body>
</html>
