---
import Layout from '../../layouts/Layout.astro';
import type { Locale } from '../../domain/types';
import { localeDefinitions, localeStaticPaths, uiTextLocale } from '../../domain/locales';

export const getStaticPaths = localeStaticPaths;

const locale = Astro.params.locale as Locale;
const zh = uiTextLocale(locale) === 'zh-CN';
const baseCopy = zh ? {
  title: '真实住宅地址生成器 API',
  intro: '每次返回一个带来源证据、坐标和国家格式的真实地址。',
  back: '返回生成器',
  endpoints: '接口',
  authentication: '鉴权',
  params: '生成参数',
  response: '响应示例',
  sources: '数据源规则'
} : {
  title: 'Real Residential Address Generator API',
  intro: 'Each request returns one source-backed address with coordinates and country-specific formatting.',
  back: 'Back to generator',
  endpoints: 'Endpoints',
  authentication: 'Authentication',
  params: 'Generate parameters',
  response: 'Response example',
  sources: 'Source policy'
};
const translatedCopy: Partial<Record<Locale, typeof baseCopy>> = {
  'zh-TW': { title: '真實住宅地址產生器 API', intro: '每次請求都會傳回一個包含來源證據、座標和國家格式的真實地址。', back: '返回產生器', endpoints: '端點', authentication: '驗證', params: '產生參數', response: '回應範例', sources: '資料來源規則' },
  ja: { title: '実在住宅住所ジェネレーター API', intro: 'リクエストごとに、根拠・座標・国別形式を含む住所を1件返します。', back: 'ジェネレーターに戻る', endpoints: 'エンドポイント', authentication: '認証', params: '生成パラメーター', response: 'レスポンス例', sources: 'データソース方針' },
  ko: { title: '실제 주거 주소 생성기 API', intro: '각 요청은 출처 근거, 좌표 및 국가별 형식을 포함한 주소 하나를 반환합니다.', back: '생성기로 돌아가기', endpoints: '엔드포인트', authentication: '인증', params: '생성 매개변수', response: '응답 예시', sources: '데이터 소스 정책' },
  de: { title: 'API für reale Adressen', intro: 'Jede Anfrage liefert eine quellenbasierte Adresse mit Koordinaten und landesüblicher Formatierung.', back: 'Zurück zum Generator', endpoints: 'Endpunkte', authentication: 'Authentifizierung', params: 'Parameter', response: 'Beispielantwort', sources: 'Datenquellen' },
  fr: { title: "API du générateur d’adresses réelles", intro: 'Chaque requête renvoie une adresse fondée sur des sources, avec coordonnées et format national.', back: 'Retour au générateur', endpoints: 'Points de terminaison', authentication: 'Authentification', params: 'Paramètres', response: 'Exemple de réponse', sources: 'Sources de données' },
  es: { title: 'API del generador de direcciones reales', intro: 'Cada solicitud devuelve una dirección respaldada por fuentes, con coordenadas y formato nacional.', back: 'Volver al generador', endpoints: 'Endpoints', authentication: 'Autenticación', params: 'Parámetros', response: 'Ejemplo de respuesta', sources: 'Fuentes de datos' },
  pt: { title: 'API do gerador de endereços reais', intro: 'Cada pedido devolve um endereço baseado em fontes, com coordenadas e formato nacional.', back: 'Voltar ao gerador', endpoints: 'Endpoints', authentication: 'Autenticação', params: 'Parâmetros', response: 'Exemplo de resposta', sources: 'Fontes de dados' }
};
const copy = translatedCopy[locale] || baseCopy;
---
<Layout locale={locale} pagePath="api">
  <main class="api-page">
    <header class="api-hero">
      <a href={`/${locale}/?country=us`}>← {copy.back}</a>
      <select id="api-locale" class="language-select" aria-label="Language">{localeDefinitions.map((definition) => <option value={definition.code} selected={definition.code === locale}>{definition.label}</option>)}</select>
      <span>v1</span>
      <h1>{copy.title}</h1>
      <p>{copy.intro}</p>
    </header>

    <section class="api-doc-card">
      <h2>{copy.authentication}</h2>
      <p>{zh ? '除健康检查外，外部接口需要管理员在 /admin/ 创建的 Bearer Token。令牌可设置权限、每分钟限速和到期时间，并可在管理员会话中查看、修改或撤销。' : 'Except for the health check, external endpoints require a Bearer token created in /admin/. Tokens support scopes, per-minute limits, expiry, reveal, editing, and revocation in an administrator session.'}</p>
      <pre><code>{`Authorization: Bearer YOUR_API_TOKEN`}</code></pre>
      <p>{zh ? '令牌无效或过期返回 401；超过每分钟限速返回 429，并附带 Retry-After: 60。' : 'Invalid or expired tokens return 401. Rate-limit exhaustion returns 429 with Retry-After: 60.'}</p>
    </section>

    <section class="api-doc-card">
      <h2>{copy.endpoints}</h2>
      <div class="endpoint"><b>GET</b><code>/api/v1/countries</code><span>{zh ? '国家、分组、能力、数据量与快捷入口' : 'Countries, groups, capabilities, counts and shortcuts'}</span></div>
      <div class="endpoint"><b>GET</b><code>/api/v1/locations/search?country=US&amp;field=city&amp;regionId=1416&amp;limit=20000</code><span>{zh ? '按父级一次读取城市；州省与邮编分页' : 'Load cities by parent once; regions and postcodes are paged'}</span></div>
      <div class="endpoint"><b>GET</b><code>/api/v1/generate?country=US&amp;residential=true&amp;requestId=UUID</code><span>{zh ? '随机生成一个地址' : 'Generate one random address'}</span></div>
      <div class="endpoint"><b>GET</b><code>/api/v1/generate?mode=ip-region&amp;ip=198.51.100.7</code><span>{zh ? '按 IP 坐标或城市匹配已同步住宅池' : 'Match the synchronized residential pool by IP coordinate or city'}</span></div>
      <div class="endpoint"><b>GET</b><code>/api/v1/data-health</code><span>{zh ? '逐国数据健康状态' : 'Per-country data health'}</span></div>
    </section>

    <section class="api-doc-card">
      <h2>{copy.params}</h2>
      <div class="parameter-grid">
        <code>country</code><span>ISO 3166-1 alpha-2 · {zh ? '默认 US' : 'default US'}</span>
        <code>residential</code><span>true | false · {zh ? '具备住宅能力的国家默认 true' : 'defaults to true where supported'}</span>
        <code>region</code><span>{zh ? '州、省、都道府县或地区的精确值' : 'Exact state, province, prefecture or area'}</span>
        <code>regionId</code><span>{zh ? '筛选城市和邮编的父级行政区 ID' : 'Parent region ID used to filter cities and postcodes'}</span>
        <code>city</code><span>{zh ? '城市精确值' : 'Exact city value'}</span>
        <code>cityId</code><span>{zh ? '筛选邮编的城市 ID' : 'City ID used to filter postcodes'}</span>
        <code>postcode</code><span>{zh ? '邮编精确值，空格不敏感' : 'Exact postcode, space-insensitive'}</span>
        <code>field / q</code><span>{zh ? '目录字段与搜索词：region、city、postcode' : 'Catalog field and search text: region, city or postcode'}</span>
        <code>cursor / limit</code><span>{zh ? '州省/邮编每页 20—200 条；城市按父级最多 20,000 条' : 'Regions/postcodes: 20–200 per page; cities: up to 20,000 per parent'}</span>
        <code>seed</code><span>{zh ? '可选的可复现随机种子' : 'Optional reproducible random seed'}</span>
        <code>requestId</code><span>{zh ? '用于校验响应上下文的请求标识' : 'Request identifier used to validate response context'}</span>
      </div>
    </section>

    <section class="api-doc-card">
      <h2>{copy.response}</h2>
      <pre><code>{`{
  "data": {
    "requestId": "UUID",
    "mode": "residential",
    "country": "US",
    "residential": true,
    "sourcesTried": ["address-pool-v2"],
    "result": {
      "addressFormats": {
        "native": { "postalLines": ["Avery Chen", "20 W 34th Street", "New York, NY 10001", "UNITED STATES"], "singleLine": "20 W 34th Street, New York, NY 10001, UNITED STATES" },
        "en": { "postalLines": ["..."], "singleLine": "..." },
        "zh-CN": { "postalLines": ["..."], "singleLine": "..." }
      },
      "profile": { "fullName": "Olivia Carter", "email": "oliviacarter0000@outlook.com" },
      "card": { "provider": "Stripe", "number": "4242 4242 4242 4242", "sandboxOnly": true },
      "googleMaps": { "status": "map_query", "embedUrl": "https://www.google.com/maps?q=LAT,LNG&z=17&output=embed" }
    }
  }
}`}</code></pre>
    </section>

    <section class="api-doc-card">
      <h2>{copy.sources}</h2>
      <p>{zh
        ? '公开生成和 IP 区域生成只读取服务器已同步、已清洗的 PostgreSQL 住宅地址池，运行时不调用在线 Provider、翻译或地理编码。IP 区域模式只接受坐标附近或同城市记录；没有覆盖时返回无结果。第三方平台仅用于后台同步。'
        : 'Public and IP-region generation read only the synchronized, cleaned PostgreSQL residential pool, with no runtime provider, translation or geocoding call. IP-region mode accepts only nearby or same-city records and returns no result when uncovered. Third-party platforms are used only by background synchronization.'}</p>
    </section>
  </main>
  <script is:inline>
    document.querySelector('#api-locale')?.addEventListener('change', (event) => {
      const target = event.target.value;
      location.assign(`/${target}/api/${location.search}${location.hash}`);
    });
  </script>
</Layout>
